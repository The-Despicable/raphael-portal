# ===========================================================================
# RAPHAEL PORTAL — ignore rules
#
# Default posture: DENY.
#
# HISTORY NOTE: create-next-app overwrote an earlier, stricter version of this
# file with its own default, which blocked `.env.example` along with `.env` and
# carried none of the private-path exclusions below. That silently prevented the
# deployment env template from ever shipping. `scripts/security-gate.sh` now
# asserts every rule in this file, so a future overwrite fails the gate.
# ============================================================================

# --- Secrets and environment ------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
credentials.json
service-account*.json
secrets/
.secrets/
.vercel

# --- Local data stores ------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.db-journal
dump*.sql
*.sql.gz
.local-data/

# --- Dependencies and build output -----------------------------------------
node_modules/
.pnpm-store/
.yarn/
bun.lockb
.next/
out/
build/
dist/
.turbo/
.nx/
*.tsbuildinfo
next-env.d.ts

# --- Logs, crash dumps, debug output ---------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.json
*.pid
*.seed
*.pid.lock

# --- Caches -----------------------------------------------------------------
.cache/
.parcel-cache/
.eslintcache
coverage/
*.lcov

