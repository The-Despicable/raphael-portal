# ===========================================================================
# Raphael Research Portal — environment template
#
#   cp .env.example .env.local
#
# SECURITY
# --------
# * This file contains PLACEHOLDERS ONLY. Never commit a real .env.
# * .gitignore excludes .env, .env.* and everything except .env.example.
# * NOTHING secret here may ever be prefixed with NEXT_PUBLIC_. Anything named
#   NEXT_PUBLIC_* is shipped to the browser.
#
# The application is designed to RUN with none of these set. Missing values
# produce an honest "configuration required" state, never a fabricated one.
# GET /api/health reports exactly what is configured.
# ===========================================================================

# --- Public site URL (NOT a secret) ----------------------------------------
# Used only to build absolute URLs for metadata. Safe to expose.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Storage ----------------------------------------------------------------
# PostgreSQL connection string (Supabase, Neon, RDS, or any managed Postgres).
# SERVER-SIDE ONLY. Enables durable chat, reviews and suggestions.
# Leave blank to use the non-durable in-memory store (development only).
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DB?sslmode=require

# Pooled/serverless variant. Preferred on Vercel, where long-lived sockets are
# exhausted by serverless invocations. Takes precedence over DATABASE_URL.
# DATABASE_POOL_URL=postgres://USER:PASSWORD@HOST:5432/DB?sslmode=require

# --- Guest sessions ---------------------------------------------------------
# HMAC key for guest session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# SERVER-SIDE ONLY. If left blank, a random per-boot key is generated, which
# invalidates all guest sessions on restart. That is the SAFE failure mode:
# sessions die rather than becoming forgeable.
# GUEST_SESSION_SECRET=

# Cookie name. Renaming this logs every visitor out of the room.
# GUEST_COOKIE_NAME=rph_guest

# Force the Secure cookie flag. Defaults to true in production.
# Only set to false for plain-HTTP local development.
# GUEST_COOKIE_SECURE=true

# --- Model provider (AI research assistant) ---------------------------------
# SERVER-SIDE ONLY. These values must never reach a NEXT_PUBLIC_ variable, a
# client component, or a client bundle.
#
# With none of these set, the assistant runs in RETRIEVAL-ONLY mode: it quotes
# project documents verbatim with full citations and generates nothing. That
# mode is genuinely useful and never fabricates a source.
#
# Any OpenAI-compatible /chat/completions endpoint will work. For NVIDIA NIM
# (build.nvidia.com) with a Nemotron 3 model:
#
#   MODEL_BASE_URL=https://integrate.api.nvidia.com/v1
#   MODEL_NAME=nvidia/nemotron-3-super-120b-a12b
#
# Discover what your own key can actually reach (the catalogue is per-account,
# and several well-known model IDs are retired or not entitled):
#   curl -H "Authorization: Bearer $MODEL_API_KEY" "$MODEL_BASE_URL/models"
#
# MODEL_API_KEY=
# MODEL_BASE_URL=https://api.example.com/v1
# MODEL_NAME=

# Nemotron 3 Super/Lightning are REASONING models. Left at the provider default
# budget, the whole completion can be consumed by internal deliberation and
# `content` comes back null — which looks identical to "the provider failed".
# These two settings prevent that.
# MODEL_MAX_TOKENS=1024
# MODEL_DISABLE_THINKING=true

# --- Rate limits ------------------------------------------------------------
# Each rule (join, rename, message, review, suggestion, assistant, report) has a
# safe built-in limit. Override any of them with RATE_LIMIT_<RULE>=<n>, or set it
# to 0 to disable that rule entirely.
#
# ASSISTANT: every question sends the whole corpus to the model, so this limit is
# also a COST control, not only an abuse control. Choose the number deliberately.
#
# Defaults are deliberately left in place: an unset variable must never expose a
# public deployment to unbounded spend or spam.
# RATE_LIMIT_ASSISTANT=12

# --- Moderation -------------------------------------------------------------
# Credential for the moderation administration endpoint
# (PATCH /api/reviews with header x-moderation-key).
#
# SERVER-SIDE ONLY. Generate with the same command as GUEST_SESSION_SECRET.
#
# While this is unset, the moderation endpoint refuses EVERY request and says
# so. Reviews are then held as PENDING and are not publicly listed, because
# publishing unreviewed text with nobody able to remove it is the worse
# failure.
# MODERATION_KEY=

# --- Outbound notification (paper suggestions) -------------------------------
# Delivers "suggest a paper" submissions to the maintainer's Telegram chat.
#
# SERVER-SIDE ONLY. A bot token is a FULL-CONTROL credential for the bot: it can
# read updates and send as the bot. Never prefix it with NEXT_PUBLIC_, never
# commit it, never paste it into a chat or an issue. If it is ever exposed,
# revoke it in BotFather with /revoke and paste the replacement only here.
#
# Create the bot:
#   1. Message @BotFather -> /newbot       (returns the token)
#
# Get the destination chat id — a bot CANNOT open a conversation, so it only
# exists after the destination has messaged the bot at least once:
#   2. Send /start to your own bot
#   3. curl "https://api.telegram.org/bot<TOKEN>/getUpdates"
#      -> result[0].message.chat.id
#
# While either value is unset, suggestions are still accepted and (when a
# database exists) recorded, and the form says plainly that no alert was sent.
# It never claims delivery that did not happen.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=